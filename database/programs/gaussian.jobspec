{
   parallel: 'omp',

   conflicts: {
      'com and gjf': 'Conflicto entre los archivos de entrada ${file}.com y ${file}.gjf',
      'not com and not gjf': 'Debe existir un archivo de entrada con extensión com o gjf',
   },

   filekeys: {
      com: 'job.com',
      gjf: 'job.gjf',
      log: 'job.log',
      chk: 'job.chk',
      wfn: 'job.wfn',
      cub: 'job.cub',
      'FILE.31': 'FILE.31',
      'FILE.32': 'FILE.32',
      'FILE.33': 'FILE.33',
      'FILE.34': 'FILE.34',
      'FILE.35': 'FILE.35',
      'FILE.36': 'FILE.36',
      'FILE.37': 'FILE.37',
      'FILE.38': 'FILE.38',
      'FILE.39': 'FILE.39',
      'FILE.40': 'FILE.40',
      'FILE.41': 'FILE.41',
   },

   inputfiles: [
      'com',
      'gjf',
      'chk',
   ],

   outputfiles: [
      'log',
      'chk',
      'wfn',
      'cub',
      'FILE.31',
      'FILE.32',
      'FILE.33',
      'FILE.34',
      'FILE.35',
      'FILE.36',
      'FILE.37',
      'FILE.38',
      'FILE.39',
      'FILE.40',
      'FILE.41',
   ],

   interpolable: [
      'gjf',
      'com',
   ],

   interpolvars: [
      'method',
      'basis',
      'charge',
      'multiplicity',
      'solvent',
   ],

   restartfiles: [
      'chk',
   ],

   posargs: [
      'gjf|com',
   ],

   filevars: {
      com_file: 'com',
      gjf_file: 'gjf',
      chk_file: 'chk',
   },

   prescript: [
      'sed -i "/^%/d" @($gjf_file|$com_file)',
      'sed -i "1i%Chk=$chk_file\\\\n%NProcShared=${nproc}\\\\n%Mem=${maxram}KB" @($gjf_file|$com_file)',
      'sed -i "/--Link1--/a%Chk=$chk_file\\\\n%NProcShared=${nproc}\\\\n%Mem=${maxram}KB" @($gjf_file|$com_file)',
   ],

}
